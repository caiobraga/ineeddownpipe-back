PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Scrape / refresh (production: always set REFRESH_SECRET; use cron + npm run refresh)
# REFRESH_SECRET=your-long-random-secret
REFRESH_MIN_HOURS=6
SCRAPE_DELAY_MS=400

# Amazon Associates tag on product links (default: inbmw-20)
# AMAZON_ASSOCIATE_TAG=inbmw-20
# AMAZON_PAGES_PER_QUERY=3
# AMAZON_QUERY_RETRIES=2
# SKIP_AMAZON_SCRAPE=true   # optional: skip Playwright scrape on AWS (keeps cached Amazon data)

# Used listings (Supabase + Stripe)
SUPABASE_URL=https://txbmkfhjknqktiljpvkg.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
USED_LISTING_FEE_CENTS=1999
SITE_URL=http://localhost:5173
